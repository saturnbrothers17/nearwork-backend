generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS (stored as String in SQLite)
// ----------------------------------------------------

// UserRole: CUSTOMER | WORKER | ADMIN
// WorkerStatus: ONLINE | OFFLINE | BUSY | ON_JOB
// WorkerVerificationStatus: PENDING | VERIFIED | REJECTED | SUSPENDED
// BookingStatus: CREATED | PAYMENT_PENDING | PAID | SEARCHING_WORKER |
//   WORKER_ASSIGNED | WORKER_ACCEPTED | WORKER_EN_ROUTE | WORKER_ARRIVED |
//   SERVICE_STARTED | SERVICE_COMPLETED | PAYMENT_SETTLED | COMPLETED |
//   CUSTOMER_CANCELLED | WORKER_CANCELLED | ADMIN_CANCELLED
// PaymentStatus: PAYMENT_PENDING | PAYMENT_SUCCESS | PAYMENT_FAILED | REFUND_PENDING | REFUNDED
// PayoutStatus: PENDING | PROCESSING | COMPLETED | FAILED
// TicketStatus: OPEN | IN_PROGRESS | RESOLVED | CLOSED
// TicketPriority: LOW | MEDIUM | HIGH | URGENT
// DiscountType: PERCENTAGE | FIXED

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  name         String
  passwordHash String
  role         String   @default("CUSTOMER")
  avatarUrl    String?
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workerProfile  WorkerProfile?
  adminProfile   AdminProfile?
  addresses      Address[]
  bookings       Booking[]       @relation("CustomerBookings")
  payments       Payment[]
  reviews        Review[]        @relation("CustomerReviews")
  notifications  Notification[]
  tickets        SupportTicket[]
  chats          Chat[]          @relation("CustomerChats")
  chatMessages   ChatMessage[]   @relation("SenderMessages")

  @@index([role])
}

model WorkerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String   @default("OFFLINE")
  verificationStatus String   @default("PENDING")
  experienceYears    Int      @default(1)
  workingRadiusKm    Float    @default(15.0)
  currentLat         Float?
  currentLng         Float?
  address            String?
  idProofType        String?
  idProofUrl         String?
  bankAccountNumber  String?
  bankIfsc           String?
  totalJobsCompleted Int      @default(0)
  averageRating      Float    @default(5.0)
  totalReviews       Int      @default(0)
  availableBalance   Float    @default(0.0)
  pendingBalance     Float    @default(0.0)
  totalWithdrawn     Float    @default(0.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  skills       WorkerSkill[]
  availability WorkerAvailability[]
  bookings     Booking[]            @relation("WorkerBookings")
  locations    WorkerLocation[]
  earnings     Earning[]
  payouts      Payout[]
  reviews      Review[]             @relation("WorkerReviews")
  chats        Chat[]               @relation("WorkerChats")

  @@index([status])
  @@index([verificationStatus])
  @@index([currentLat, currentLng])
}

model AdminProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String     @default("Operations")
  permissions String     @default("ALL")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditLogs   AuditLog[]
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services     Service[]
  workerSkills WorkerSkill[]

  @@index([isActive, sortOrder])
}

model Service {
  id              String          @id @default(cuid())
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  slug            String          @unique
  description     String
  basePrice       Float
  durationMinutes Int             @default(60)
  inclusions      String          // JSON array string
  icon            String?
  imageUrl        String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bookings Booking[]

  @@index([categoryId])
  @@index([isActive])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  addressLine String
  landmark    String?
  city        String
  state       String
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([userId])
  @@index([isDefault])
}

model Booking {
  id                  String    @id @default(cuid())
  bookingNumber       String    @unique
  customerId          String
  customer            User      @relation("CustomerBookings", fields: [customerId], references: [id])
  workerId            String?
  worker              WorkerProfile? @relation("WorkerBookings", fields: [workerId], references: [id])
  serviceId           String
  service             Service   @relation(fields: [serviceId], references: [id])
  addressId           String
  address             Address   @relation(fields: [addressId], references: [id])
  status              String    @default("CREATED")
  scheduledDate       String    // YYYY-MM-DD
  scheduledTimeSlot   String    // e.g. "10:00 AM"
  basePrice           Float
  visitCharge         Float     @default(50.0)
  taxAmount           Float     @default(0.0)
  discountAmount      Float     @default(0.0)
  extraChargeAmount   Float     @default(0.0)
  extraChargeReason   String?
  extraChargeApproved Boolean?
  totalAmount         Float
  otp                 String
  instructions        String?
  problemPhotos       String?   // JSON array
  beforePhotos        String?   // JSON array
  afterPhotos         String?   // JSON array
  assignedAt          DateTime?
  acceptedAt          DateTime?
  enRouteAt           DateTime?
  arrivedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  cancelledByRole     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  statusHistory BookingStatusHistory[]
  payment       Payment?
  refund        Refund?
  chat          Chat?
  review        Review?
  earning       Earning?
  invoice       Invoice?
  supportTickets SupportTicket[]

  @@index([customerId])
  @@index([workerId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledDate])
}

model BookingStatusHistory {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  changedBy String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model Payment {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  amount            Float
  currency          String   @default("INR")
  status            String   @default("PAYMENT_PENDING")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refund Refund?

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String   @unique
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount           Float
  status           String   @default("REFUND_PENDING")
  reason           String?
  razorpayRefundId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WorkerLocation {
  id        String        @id @default(cuid())
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  accuracy  Float?
  updatedAt DateTime      @default(now())

  @@index([workerId])
  @@index([updatedAt])
}

model WorkerAvailability {
  id        String        @id @default(cuid())
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isOff     Boolean       @default(false)

  @@unique([workerId, dayOfWeek])
}

model WorkerSkill {
  id              String          @id @default(cuid())
  workerId        String
  worker          WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  experienceYears Int             @default(1)

  @@unique([workerId, categoryId])
}

model Review {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CustomerReviews", fields: [customerId], references: [id])
  workerId   String
  worker     WorkerProfile @relation("WorkerReviews", fields: [workerId], references: [id])
  rating     Int
  review     String?
  createdAt  DateTime      @default(now())

  @@index([workerId])
  @@index([customerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Chat {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CustomerChats", fields: [customerId], references: [id])
  workerId   String
  worker     WorkerProfile @relation("WorkerChats", fields: [workerId], references: [id])
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SenderMessages", fields: [senderId], references: [id])
  message   String
  imageUrl  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

model Earning {
  id                 String        @id @default(cuid())
  workerId           String
  worker             WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  bookingId          String        @unique
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount        Float
  platformCommission Float
  netWorkerEarning   Float
  status             String        @default("SETTLED")
  createdAt          DateTime      @default(now())

  @@index([workerId])
}

model Payout {
  id           String        @id @default(cuid())
  payoutNumber String        @unique
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount       Float
  status       String        @default("PENDING")
  bankAccount  String
  bankIfsc     String
  referenceId  String?
  processedAt  DateTime?
  createdAt    DateTime      @default(now())

  @@index([workerId])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   @default("PERCENTAGE")
  discountValue Float
  minOrderValue Float    @default(0.0)
  maxDiscount   Float?
  usageLimit    Int      @default(100)
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([isActive])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId    String
  workerId      String?
  subtotal      Float
  visitCharge   Float
  tax           Float
  discount      Float
  extraCharges  Float    @default(0.0)
  total         Float
  pdfUrl        String?
  createdAt     DateTime @default(now())
}

model SupportTicket {
  id           String    @id @default(cuid())
  ticketNumber String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  category     String
  subject      String
  description  String
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String       @id @default(cuid())
  adminId   String
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime     @default(now())

  @@index([adminId])
  @@index([entity, entityId])
}
